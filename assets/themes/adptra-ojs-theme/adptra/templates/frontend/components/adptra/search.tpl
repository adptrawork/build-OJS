<section class="adptra-search" aria-label="{translate key="plugins.themes.adptra.home.searchAria"}">
    <form class="adptra-search__form" method="get" action="{url page="search"}" role="search">
        <label for="adptra-search-query">{translate key="plugins.themes.adptra.home.searchLabel"}</label>
        <div class="adptra-search__controls">
            <input id="adptra-search-query" type="search" name="query"
                placeholder="{translate key="plugins.themes.adptra.home.searchPlaceholder"}"
                autocomplete="off">
            <button type="submit">{translate key="plugins.themes.adptra.home.searchButton"}</button>
        </div>
    </form>
</section>
