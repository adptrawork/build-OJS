msgid "plugins.themes.jrdc.name"
msgstr "Tema JRDC"

msgid "plugins.themes.jrdc.description"
msgstr "Tema Modern Academic Editorial untuk OJS 3.3. Terinspirasi dari desain Jurnal Ekonomi dan Bisnis JRDC — warna burnt orange, hero navy dalam, dark mode, dan semua komponen dapat dikonfigurasi dari panel admin."

msgid "plugins.themes.jrdc.option.primaryColour.label"
msgstr "Warna Primer"

msgid "plugins.themes.jrdc.option.primaryColour.description"
msgstr "Warna merek utama untuk tombol, status aktif, badge, dan highlight (default: Burnt Orange #c2410c)."

msgid "plugins.themes.jrdc.option.primaryHoverColour.label"
msgstr "Warna Hover Primer"

msgid "plugins.themes.jrdc.option.primaryHoverColour.description"
msgstr "Warna lebih gelap saat hover tombol primer."

msgid "plugins.themes.jrdc.option.navyHeroColour.label"
msgstr "Warna Navy Hero"

msgid "plugins.themes.jrdc.option.navyHeroColour.description"
msgstr "Navy dalam untuk latar hero di beranda."

msgid "plugins.themes.jrdc.option.navyDarkColour.label"
msgstr "Navy Mode Gelap"

msgid "plugins.themes.jrdc.option.navyDarkColour.description"
msgstr "Navy terdalam untuk mode gelap."

msgid "plugins.themes.jrdc.option.enableDarkMode.label"
msgstr "Toggle Mode Gelap"

msgid "plugins.themes.jrdc.option.enableDarkMode.description"
msgstr "Tampilkan saklar mode gelap/terang di header."

msgid "plugins.themes.jrdc.option.enableDarkMode.enable"
msgstr "Aktifkan"

msgid "plugins.themes.jrdc.option.enableDarkMode.disable"
msgstr "Nonaktifkan"

msgid "plugins.themes.jrdc.option.showHeroCover.label"
msgstr "Tampilkan Cover di Hero"

msgid "plugins.themes.jrdc.option.showHeroCover.description"
msgstr "Tampilkan gambar cover issue terkini di dalam hero beranda."

msgid "plugins.themes.jrdc.option.heroEyebrow.label"
msgstr "Teks Eyebrow Hero"

msgid "plugins.themes.jrdc.option.heroEyebrow.description"
msgstr "Label kecil huruf besar di atas judul jurnal pada hero."

msgid "plugins.themes.jrdc.option.showIssueCoverOnHomepage.label"
msgstr "Tampilkan Cover Issue"

msgid "plugins.themes.jrdc.option.showIssueCoverOnHomepage.description"
msgstr "Tampilkan cover issue terkini di beranda."

msgid "plugins.themes.jrdc.option.showJournalDescription.label"
msgstr "Tampilkan Deskripsi Jurnal"

msgid "plugins.themes.jrdc.option.showJournalDescription.description"
msgstr "Tampilkan blok deskripsi/tentang jurnal di beranda."

msgid "plugins.themes.jrdc.option.showAnnouncementsOnHomepage.label"
msgstr "Tampilkan Pengumuman di Beranda"

msgid "plugins.themes.jrdc.option.showAnnouncementsOnHomepage.description"
msgstr "Tampilkan pengumuman terbaru di beranda."

msgid "plugins.themes.jrdc.option.announcementsHomepageCount.label"
msgstr "Jumlah Pengumuman"

msgid "plugins.themes.jrdc.option.announcementsHomepageCount.description"
msgstr "Berapa banyak pengumuman yang ditampilkan di beranda (default: 3)."

msgid "plugins.themes.jrdc.option.showCurrentIssueArticles.label"
msgstr "Tampilkan Artikel Issue Terkini"

msgid "plugins.themes.jrdc.option.showCurrentIssueArticles.description"
msgstr "Daftar artikel dari issue terkini di beranda."

msgid "plugins.themes.jrdc.option.sidebarPosition.label"
msgstr "Posisi Sidebar"

msgid "plugins.themes.jrdc.option.sidebarPosition.description"
msgstr "Letak blok sidebar."

msgid "plugins.themes.jrdc.option.sidebarPosition.right"
msgstr "Kanan"

msgid "plugins.themes.jrdc.option.sidebarPosition.left"
msgstr "Kiri"

msgid "plugins.themes.jrdc.option.sidebarPosition.none"
msgstr "Sembunyikan Sidebar"

msgid "plugins.themes.jrdc.option.baseFontSize.label"
msgstr "Ukuran Font Dasar (px)"

msgid "plugins.themes.jrdc.option.baseFontSize.description"
msgstr "Ukuran font root dalam pixel (disarankan 15–17)."

msgid "plugins.themes.jrdc.option.useGoogleFonts.label"
msgstr "Muat Google Fonts"

msgid "plugins.themes.jrdc.option.useGoogleFonts.description"
msgstr "Muat Inter + Merriweather dari Google Fonts. Nonaktifkan jika ingin system font atau self-host."
