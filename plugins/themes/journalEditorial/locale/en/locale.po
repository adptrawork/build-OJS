msgid "plugins.themes.journalEditorial.about.jrdcIdentityTitle"
msgstr "Who We Are"

msgid "plugins.themes.journalEditorial.about.jrdcIdentity"
msgstr "Yayasan Ratu Dirgantara Cendikiawan (JRDC) is a scientific journal publisher focused on Economics and Business. We support education, advance scientific knowledge, and disseminate research and academic thought by providing a credible publication space for academics, researchers, students, and practitioners."

msgid "plugins.themes.journalEditorial.about.jrdcVisionTitle"
msgstr "Vision"

msgid "plugins.themes.journalEditorial.about.jrdcVision"
msgstr "To become a credible scientific journal publisher that advances knowledge in Economics and Business through quality, integrity-driven, and beneficial publications for academic and professional communities."

msgid "plugins.themes.journalEditorial.about.jrdcMissionTitle"
msgstr "Mission"

msgid "plugins.themes.journalEditorial.about.jrdcMission"
msgstr "<ol><li>Advance knowledge in Economics and Business by publishing research and scientific studies.</li><li>Conduct journal publishing that prioritises article quality, editorial accuracy, and scientific publication standards.</li><li>Encourage a culture of research, writing, and scientific publication among academics, researchers, and students.</li><li>Facilitate the dissemination of research relevant to theory building, decision making, and economic and business practice.</li><li>Uphold publication ethics, academic integrity, and open access to scientific knowledge.</li></ol>"

msgid "plugins.themes.journalEditorial.about.jrdcScopeTitle"
msgstr "Focus &amp; Scope"

msgid "plugins.themes.journalEditorial.about.jrdcScope"
msgstr "JRDC's initial publishing focus is Economics and Business. The scope covers management, accounting, finance, marketing, entrepreneurship, and development economics. Studies may include theory building, empirical research, policy analysis, case studies, and the application of economic and business concepts in various contexts. The scope may expand gradually according to scholarly needs while maintaining Economics and Business as the core orientation."

msgid "plugins.themes.journalEditorial.about.jrdcCommitmentTitle"
msgstr "Editorial Commitment"

msgid "plugins.themes.journalEditorial.about.jrdcCommitment"
msgstr "JRDC is committed to responsible scholarly publishing through peer review, academic integrity, and open access. Peer review safeguards the quality and scientific merit of every published manuscript. Integrity is upheld through respect for originality, accurate citation, transparency, and the prevention of unethical publication practices. Open access ensures research findings can be used more broadly by researchers, students, practitioners, and the wider community. This commitment builds trust between authors and readers."

