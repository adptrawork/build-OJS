<section class="je-section" aria-labelledby="je-flow-title" style="background: var(--je-surface-container-low);">
	<div class="je-container">
		<div class="je-section__header">
			<div>
				<h2 id="je-flow-title" class="je-section__title">Transparent Editorial &amp; Publication Flow</h2>
				<p class="je-section__subtitle">Our standardized, double-blind peer review trajectory guarantees rigorous oversight.</p>
			</div>
		</div>
		<div class="je-timeline">
			<div class="je-timeline__step">
				<div class="je-timeline__icon">
					<span class="material-symbols-outlined">upload_file</span>
				</div>
				<div class="je-timeline__title">Submission</div>
				<div class="je-timeline__desc">Manuscript submitted via OJS</div>
			</div>
			<div class="je-timeline__step">
				<div class="je-timeline__icon">
					<span class="material-symbols-outlined">search</span>
				</div>
				<div class="je-timeline__title">Desk Review</div>
				<div class="je-timeline__desc">Initial screening by editor</div>
			</div>
			<div class="je-timeline__step">
				<div class="je-timeline__icon">
					<span class="material-symbols-outlined">rate_review</span>
				</div>
				<div class="je-timeline__title">Peer Review</div>
				<div class="je-timeline__desc">Double-blind review by experts</div>
			</div>
			<div class="je-timeline__step">
				<div class="je-timeline__icon">
					<span class="material-symbols-outlined">publish</span>
				</div>
				<div class="je-timeline__title">Publication</div>
				<div class="je-timeline__desc">Published online with DOI</div>
			</div>
		</div>
	</div>
</section>
