msgid "plugins.themes.sanguline.name"
msgstr "Tema Sanguline"

msgid "plugins.themes.sanguline.description"
msgstr "Tema modern dan elegan untuk OJS. Dibuat oleh Thoha Firdaus dengan cinta untuk komunitas akademik."

msgid "plugins.themes.sanguline.option.typography.label"
msgstr "Tipografi"

msgid "plugins.themes.sanguline.option.typography.description"
msgstr "Silakan pilih kombinasi huruf sesuai dengan jurnal Anda."

msgid "plugins.themes.sanguline.option.typography.notoSans"
msgstr ""
"Noto Sans: Sebuah huruf digital yang dirancang oleh Google untuk mendukung "
"semua bahasa."

msgid "plugins.themes.sanguline.option.typography.notoSerif"
msgstr "Noto Serif: Sebuah varian Serif dari huruf digital asli Google."

msgid "plugins.themes.sanguline.option.typography.notoSerif_notoSans"
msgstr ""
"Noto Serif/Noto Sans: Gabungan yang saling melengkapi di mana heading "
"menggunakan serif dan isi teks menggunakan sans-serif."

msgid "plugins.themes.sanguline.option.typography.notoSans_notoSerif"
msgstr ""
"Noto Sans/Noto Serif: Gabungan yang saling melengkapi di mana heading "
"menggunakan ssans-serif dan isi teks menggunakan serif."

msgid "plugins.themes.sanguline.option.typography.lato"
msgstr "Lato: Jenis huruf sans-serif yang populer dan modern."

msgid "plugins.themes.sanguline.option.typography.lora"
msgstr ""
"Lora: Jenis huruf serif yang banyak diakai dan cocok buat membaca daring."

msgid "plugins.themes.sanguline.option.typography.lora_openSans"
msgstr ""
"Lora/Open Sans: Gabungan yang saling melengkapi di mana heading menggunakan "
"serif dan isi teks menggunakan sans-serif."

msgid "plugins.themes.sanguline.option.colour.label"
msgstr "Warna"

msgid "plugins.themes.sanguline.option.colour.description"
msgstr "Pilih warna untuk bagian header."

msgid "plugins.themes.sanguline.option.showDescriptionInJournalIndex.option"
msgstr "Menampilkan riwayat jurnal pada halaman beranda."

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.label"
msgstr "Pindahkan Gambar Beranda ke Header"

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.description"
msgstr ""
"Jika diaktifkan, gambar beranda akan dipindahkan ke latar header dan "
"TIDAK akan ditampilkan di posisi biasanya pada halaman beranda. Biarkan "
"tidak dicentang untuk menampilkan gambar di bagian hero halaman beranda."

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.option"
msgstr "Pindahkan gambar beranda ke latar header (sembunyikan dari hero beranda)."

msgid "plugins.themes.sanguline.option.displayStats.label"
msgstr "Pilihan tampilan statistik penggunaan"

msgid "plugins.themes.sanguline.option.displayStats.none"
msgstr "Jangan tampilkan bagan statistik aktivitas naskah kepada pembaca."

msgid "plugins.themes.sanguline.option.displayStats.bar"
